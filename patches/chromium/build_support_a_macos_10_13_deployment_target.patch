diff --git a/base/mac/uttype_compat.h b/base/mac/uttype_compat.h
new file mode 100644
index 0000000000000000000000000000000000000000..1f3445dd2069085d9754bc4a082869312588b70a
--- /dev/null
+++ b/base/mac/uttype_compat.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_MAC_UTTYPE_COMPAT_H_
+#define BASE_MAC_UTTYPE_COMPAT_H_
+
+#import <Foundation/Foundation.h>
+
+#include "base/base_export.h"
+
+// UTType from UniformTypeIdentifiers needs macOS 11. These functions work on
+// UTType identifier strings instead, using UTType where it exists and the
+// Launch Services UTType functions it replaced before that.
+
+namespace base::mac {
+
+// Returns the identifier of the type for a filename extension (without the
+// leading dot) or a MIME type. As with UTType, these return a dynamic type
+// for tags that the system doesn't know.
+BASE_EXPORT NSString* UTTypeIdentifierForFilenameExtension(
+    NSString* extension);
+BASE_EXPORT NSString* UTTypeIdentifierForMIMEType(NSString* mime_type);
+
+// Returns the preferred filename extension or MIME type of a type, or nil.
+BASE_EXPORT NSString* UTTypePreferredFilenameExtension(NSString* identifier);
+BASE_EXPORT NSString* UTTypePreferredMIMEType(NSString* identifier);
+
+// Returns the localized description of a type, or nil.
+BASE_EXPORT NSString* UTTypeLocalizedDescription(NSString* identifier);
+
+// Returns whether a type is dynamic, i.e. made up by the system for an unknown
+// tag.
+BASE_EXPORT bool UTTypeIsDynamic(NSString* identifier);
+
+// Returns whether a type conforms to another type. Returns false if either is
+// nil.
+BASE_EXPORT bool UTTypeConformsTo(NSString* identifier,
+                                  NSString* conforms_to_identifier);
+
+// Returns the identifier of the content type of the file at `url`, or nil.
+BASE_EXPORT NSString* UTTypeIdentifierForFileURL(NSURL* url);
+
+}  // namespace base::mac
+
+#endif  // BASE_MAC_UTTYPE_COMPAT_H_
diff --git a/base/mac/uttype_compat.mm b/base/mac/uttype_compat.mm
new file mode 100644
index 0000000000000000000000000000000000000000..c7a48f6c8349bd956a7627936f00cbe1b1c0cbf6
--- /dev/null
+++ b/base/mac/uttype_compat.mm
@@ -0,0 +1,111 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "base/mac/uttype_compat.h"
+
+#import <CoreServices/CoreServices.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+#include "base/apple/bridging.h"
+#include "base/apple/scoped_cftyperef.h"
+
+namespace base::mac {
+
+namespace {
+
+NSString* LegacyIdentifierForTag(CFStringRef tag_class, NSString* tag) {
+  if (!tag) {
+    return nil;
+  }
+  return apple::CFToNSOwnershipCast(UTTypeCreatePreferredIdentifierForTag(
+      tag_class, apple::NSToCFPtrCast(tag), /*inConformingToUTI=*/nullptr));
+}
+
+NSString* LegacyPreferredTag(NSString* identifier, CFStringRef tag_class) {
+  if (!identifier) {
+    return nil;
+  }
+  return apple::CFToNSOwnershipCast(UTTypeCopyPreferredTagWithClass(
+      apple::NSToCFPtrCast(identifier), tag_class));
+}
+
+}  // namespace
+
+NSString* UTTypeIdentifierForFilenameExtension(NSString* extension) {
+  if (@available(macOS 11.0, *)) {
+    return [UTType typeWithFilenameExtension:extension].identifier;
+  }
+  return LegacyIdentifierForTag(kUTTagClassFilenameExtension, extension);
+}
+
+NSString* UTTypeIdentifierForMIMEType(NSString* mime_type) {
+  if (@available(macOS 11.0, *)) {
+    return [UTType typeWithMIMEType:mime_type].identifier;
+  }
+  return LegacyIdentifierForTag(kUTTagClassMIMEType, mime_type);
+}
+
+NSString* UTTypePreferredFilenameExtension(NSString* identifier) {
+  if (@available(macOS 11.0, *)) {
+    return [UTType typeWithIdentifier:identifier].preferredFilenameExtension;
+  }
+  return LegacyPreferredTag(identifier, kUTTagClassFilenameExtension);
+}
+
+NSString* UTTypePreferredMIMEType(NSString* identifier) {
+  if (@available(macOS 11.0, *)) {
+    return [UTType typeWithIdentifier:identifier].preferredMIMEType;
+  }
+  return LegacyPreferredTag(identifier, kUTTagClassMIMEType);
+}
+
+NSString* UTTypeLocalizedDescription(NSString* identifier) {
+  if (@available(macOS 11.0, *)) {
+    return [UTType typeWithIdentifier:identifier].localizedDescription;
+  }
+  if (!identifier) {
+    return nil;
+  }
+  return apple::CFToNSOwnershipCast(
+      UTTypeCopyDescription(apple::NSToCFPtrCast(identifier)));
+}
+
+bool UTTypeIsDynamic(NSString* identifier) {
+  if (@available(macOS 11.0, *)) {
+    return [UTType typeWithIdentifier:identifier].dynamic;
+  }
+  return identifier && ::UTTypeIsDynamic(apple::NSToCFPtrCast(identifier));
+}
+
+bool UTTypeConformsTo(NSString* identifier, NSString* conforms_to_identifier) {
+  if (!identifier || !conforms_to_identifier) {
+    return false;
+  }
+  if (@available(macOS 11.0, *)) {
+    UTType* type = [UTType typeWithIdentifier:identifier];
+    UTType* conforms_to = [UTType typeWithIdentifier:conforms_to_identifier];
+    return type && conforms_to && [type conformsToType:conforms_to];
+  }
+  return ::UTTypeConformsTo(apple::NSToCFPtrCast(identifier),
+                            apple::NSToCFPtrCast(conforms_to_identifier));
+}
+
+NSString* UTTypeIdentifierForFileURL(NSURL* url) {
+  if (@available(macOS 11.0, *)) {
+    UTType* type;
+    if ([url getResourceValue:&type forKey:NSURLContentTypeKey error:nil]) {
+      return type.identifier;
+    }
+    return nil;
+  }
+  NSString* identifier;
+  if ([url getResourceValue:&identifier
+                     forKey:NSURLTypeIdentifierKey
+                      error:nil]) {
+    return identifier;
+  }
+  return nil;
+}
+
+}  // namespace base::mac
