+NSString* UTTypeIdentifierForServicesType(NSString* type) {
+  if (@available(macOS 11.0, *)) {
+    return UTTypeForServicesType(type).identifier;
+  }
+  if (!type) {
+    return nil;
+  }
+
+  // Before macOS 11, use the Launch Services UTType functions, which
+  // UniformTypeIdentifiers replaced.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  CFStringRef cf_type = base::apple::NSToCFPtrCast(type);
+  if (UTTypeIsDeclared(cf_type)) {
+    return type;
+  }
+  base::apple::ScopedCFTypeRef<CFStringRef> uti(
+      UTTypeCreatePreferredIdentifierForTag(CFSTR("com.apple.nspboard-type"),
+                                            cf_type, nullptr));
+  if (!uti || UTTypeIsDynamic(uti.get())) {
+    return nil;
+  }
+#pragma clang diagnostic pop
+  return base::apple::CFToNSOwnershipCast(uti.release());
+}
+
+NSSet<NSString*>* UTTypeIdentifiersForServicesTypeArray(NSArray* types) {
+  NSMutableSet* result = [NSMutableSet set];
+  for (NSString* type in types) {
+    if (NSString* identifier = UTTypeIdentifierForServicesType(type)) {
+      [result addObject:identifier];
+    }
+  }
+  return result;
+}
+
 }  // namespace ui
