diff --git a/mojo/core/ipcz_driver/base_shared_memory_service.cc b/mojo/core/ipcz_driver/base_shared_memory_service.cc
index c56620189d93e48263d5f713c7be631f9df5eb68..ecc15c58f7500d0cab59fdd45d9a75230fa979f7 100644
--- a/mojo/core/ipcz_driver/base_shared_memory_service.cc
+++ b/mojo/core/ipcz_driver/base_shared_memory_service.cc
@@ -110,6 +110,20 @@ Broker* g_client = nullptr;
 
 #endif  // SHARED_MEMORY_SERVICE_REQUIRED()
 
+#if BUILDFLAG(IS_WIN)
+
+void CreateWindowsBrokerHostOnIOThread(base::Process client_process,
+                                       PlatformChannelEndpoint endpoint) {
+  // Self-owned. BrokerHost duplicates each section it allocates into
+  // `client_process`.
+  new BrokerHost(std::move(client_process),
+                 ConnectionParams(std::move(endpoint)), base::NullCallback());
+}
+
+Broker* g_windows_client = nullptr;
+
+#endif  // BUILDFLAG(IS_WIN)
+
 base::WritableSharedMemoryRegion CreateWritableSharedMemoryRegion(size_t size) {
   return BaseSharedMemoryService::CreateWritableRegion(size);
 }
@@ -181,6 +195,11 @@ base::WritableSharedMemoryRegion BaseSharedMemoryService::CreateWritableRegion(
     return {};
   }
   return g_client->GetWritableSharedMemoryRegion(size);
+#elif BUILDFLAG(IS_WIN)
+  if (!g_windows_client) {
+    return {};
+  }
+  return g_windows_client->GetWritableSharedMemoryRegion(size);
 #else
   // The shared memory service is not needed on other platforms, so this method
   // should never be called.
@@ -188,4 +207,25 @@ base::WritableSharedMemoryRegion BaseSharedMemoryService::CreateWritableRegion(
 #endif
 }
 
+#if BUILDFLAG(IS_WIN)
+// static
+void BaseSharedMemoryService::CreateWindowsService(
+    base::Process client_process,
+    PlatformChannelEndpoint endpoint) {
+  Transport::GetIOTaskRunner()->PostTask(
+      FROM_HERE, base::BindOnce(&CreateWindowsBrokerHostOnIOThread,
+                                std::move(client_process), std::move(endpoint)));
+}
+
+// static
+void BaseSharedMemoryService::CreateWindowsClient(
+    PlatformChannelEndpoint endpoint) {
+  DCHECK(!g_windows_client);
+  if (endpoint.is_valid()) {
+    g_windows_client = new Broker(endpoint.TakePlatformHandle(),
+                                  /*wait_for_channel_handle=*/false);
+  }
+}
+#endif  // BUILDFLAG(IS_WIN)
+
 }  // namespace mojo::core::ipcz_driver
