--- a/mojo/core/embedder/embedder.h
+++ b/mojo/core/embedder/embedder.h
@@ -69,6 +69,18 @@ COMPONENT_EXPORT(MOJO_CORE_EMBEDDER) bool IsMojoIpczEnabled();
 COMPONENT_EXPORT(MOJO_CORE_EMBEDDER)
 void InstallMojoIpczBaseSharedMemoryHooks();
 
+#if BUILDFLAG(IS_WIN)
+// Sandboxed processes cannot create their own shared memory before Windows
+// 8.1. Serves base shared memory allocation requests from `client_process`
+// over `endpoint`, whose other end the child passes to
+// SetBaseSharedMemoryBrokerEndpoint() before installing the hooks above.
