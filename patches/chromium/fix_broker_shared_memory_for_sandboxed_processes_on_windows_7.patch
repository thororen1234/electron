From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thororen <78185467+thororen1234@users.noreply.github.com>
Date: Fri, 16 Oct 2026 22:41:47 -0400
Subject: fix: broker shared memory for sandboxed processes on Windows 7

Sandboxed processes cannot create sections themselves before Windows 8.1,
so renderers and the GPU process failed every shared memory allocation
and were killed as out of memory. Chromium brokered these allocations
through the browser before dropping Windows 7, but MojoIpcz only
implements that service on POSIX.

Restore brokering below Windows 8.1: the browser passes each child a
dedicated pipe at launch and serves allocation requests over it with
the existing Broker and BrokerHost, and sandboxed children install the
shared memory hooks to use it.

This patch is needed for Windows 7 support and is not suitable for
upstreaming.

diff --git a/content/app/initialize_mojo_core.cc b/content/app/initialize_mojo_core.cc
index 2c21dd0d8e4326020ee5800a40d64c70453def5b..fb714c793e4b98a35b827aff7aa4ba23f8c480f9 100644
--- a/content/app/initialize_mojo_core.cc
+++ b/content/app/initialize_mojo_core.cc
@@ -18,6 +18,10 @@
 #include "mojo/public/cpp/platform/platform_channel.h"
 #include "sandbox/policy/sandbox_type.h"
 
+#if BUILDFLAG(IS_WIN)
+#include "base/win/windows_version.h"
+#endif
+
 namespace content {
 
 void InitializeMojoCore() {
@@ -43,9 +47,12 @@ void InitializeMojoCore() {
       config.force_direct_shared_memory_allocation = true;
   } else {
 #if BUILDFLAG(IS_WIN)
-    // On Windows it's not necessary to broker shared memory allocation, as
-    // even sandboxed processes can allocate their own without trouble.
-    config.force_direct_shared_memory_allocation = true;
+    // On Windows 8.1 and later it's not necessary to broker shared memory
+    // allocation, as even sandboxed processes can allocate their own without
+    // trouble.
+    if (base::win::GetVersion() >= base::win::Version::WIN8_1) {
+      config.force_direct_shared_memory_allocation = true;
+    }
 #endif
   }
 
@@ -74,9 +81,22 @@ void InitializeMojoCore() {
     // Sanity check, since installing the shared memory hooks in a broker
     // process will lead to infinite recursion.
     DCHECK(!config.is_broker_process);
+#if BUILDFLAG(IS_WIN)
+    // Before Windows 8.1, the browser passes a pipe to request shared memory
+    // through. Without one, fall back to allocating directly.
+    mojo::PlatformChannelEndpoint broker_endpoint =
+        mojo::PlatformChannel::RecoverPassedEndpointFromString(
+            command_line.GetSwitchValueASCII(
+                switches::kMojoSharedMemoryBrokerHandle));
+    if (broker_endpoint.is_valid()) {
+      mojo::core::SetBaseSharedMemoryBrokerEndpoint(std::move(broker_endpoint));
+      mojo::SharedMemoryUtils::InstallBaseHooks();
+    }
+#else
     // Otherwise, this is a sandboxed process that will need brokering to
     // allocate shared memory.
     mojo::SharedMemoryUtils::InstallBaseHooks();
+#endif
   }
 #endif  // !BUILDFLAG(IS_APPLE) && !BUILDFLAG(IS_FUCHSIA)
 }
