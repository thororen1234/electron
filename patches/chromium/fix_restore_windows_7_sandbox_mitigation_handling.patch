From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thororen <78185467+thororen1234@users.noreply.github.com>
Date: Thu, 8 Oct 2026 23:55:17 -0400
Subject: fix: restore Windows 7 sandbox mitigation handling

Windows 7 only supports the DEP and SEHOP process creation mitigations,
passed as a DWORD on 32-bit, and has no GetProcessMitigationPolicy or
SetProcessMitigationPolicy. Restore the version checks Chromium had
before dropping Windows 7 (M109), and skip the unsandboxed job object
when the browser is already in a job, since Windows 7 doesn't support
nested jobs.

The sandbox also relies on job, token and handle APIs that changed in
Windows 8, so child processes are launched unsandboxed on Windows 7 for
now.

This patch is needed for Windows 7 support and is not suitable for
upstreaming.

diff --git a/sandbox/policy/win/sandbox_win.cc b/sandbox/policy/win/sandbox_win.cc
index daeb9327d28fab06bcb1375606e18419063850d6..d70057cf3785a343df539754c9d6878332fddb2e 100644
--- a/sandbox/policy/win/sandbox_win.cc
+++ b/sandbox/policy/win/sandbox_win.cc
@@ -639,7 +639,13 @@ ResultCode LaunchWithoutSandbox(
   // does not outlive the browser, which could happen if there is a lot of I/O
   // on process shutdown, in which case TerminateProcess can fail. See
   // https://crbug.com/820996.
-  if (delegate->ShouldUnsandboxedRunInJob()) {
+  // Prior to Windows 8 nested jobs aren't possible, so skip the job if this
+  // process is already in one.
+  BOOL in_job = FALSE;
+  const bool can_use_job =
+      base::win::GetVersion() >= base::win::Version::WIN8 ||
+      (::IsProcessInJob(::GetCurrentProcess(), nullptr, &in_job) && !in_job);
+  if (delegate->ShouldUnsandboxedRunInJob() && can_use_job) {
     static base::NoDestructor<base::win::ScopedHandle> job_object(
         CreateUnsandboxedJob());
     if (!job_object->is_valid()) {
@@ -671,6 +677,10 @@ bool IsUnsandboxedProcess(
     const base::CommandLine& launcher_process_command_line) {
   if (IsUnsandboxedSandboxType(sandbox_type))
     return true;
+  // TODO: The sandbox relies on job, token and handle APIs that changed in
+  // Windows 8, so child processes run unsandboxed on Windows 7 for now.
+  if (base::win::GetVersion() < base::win::Version::WIN8)
+    return true;
   if (cmd_line.HasSwitch(switches::kNoSandbox))
     return true;
   if (launcher_process_command_line.HasSwitch(switches::kNoSandbox))
@@ -972,9 +982,17 @@ ResultCode SandboxWin::StartSandboxedProcess(
   // Avoid making a policy if we won't use it.
   if (IsUnsandboxedProcess(delegate->GetSandboxType(), cmd_line,
                            *base::CommandLine::ForCurrentProcess())) {
+    // Child processes always run unsandboxed on Windows 7 (see
+    // IsUnsandboxedProcess()). Tell them so, or processes that expect a
+    // sandbox, like renderers, fail to enable it and exit.
+    base::CommandLine child_cmd_line = cmd_line;
+    if (base::win::GetVersion() < base::win::Version::WIN8 &&
+        !child_cmd_line.HasSwitch(switches::kNoSandbox)) {
+      child_cmd_line.AppendSwitch(switches::kNoSandbox);
+    }
     base::Process process;
     ResultCode result =
-        LaunchWithoutSandbox(cmd_line, *options, delegate, &process);
+        LaunchWithoutSandbox(child_cmd_line, *options, delegate, &process);
     DWORD last_error = GetLastError();
     std::move(result_callback).Run(std::move(process), last_error, result);
     return SBOX_ALL_OK;
diff --git a/sandbox/win/src/process_mitigations.cc b/sandbox/win/src/process_mitigations.cc
index 38ae75ee7b2b9716b3f7c57b6f9c74a67a911d7b..beb590a7620159dca8f20e76f991db5ff010979a 100644
--- a/sandbox/win/src/process_mitigations.cc
+++ b/sandbox/win/src/process_mitigations.cc
@@ -58,9 +58,16 @@ const ULONG64* GetSupportedMitigations() {
         (base::win::GetVersion() >= base::win::Version::WIN10_RS2)
             ? (sizeof(mitigations[0]) * 2)
             : sizeof(mitigations[0]);
-    if (!::GetProcessMitigationPolicy(::GetCurrentProcess(),
-                                      ProcessMitigationOptionsMask,
-                                      &mitigations, mits_size)) {
+    // GetProcessMitigationPolicy() requires Windows 8. Before that, no
+    // mitigations beyond DEP and SEHOP are supported.
+    static const auto get_process_mitigation_policy =
+        reinterpret_cast<decltype(&::GetProcessMitigationPolicy)>(
+            ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"),
+                             "GetProcessMitigationPolicy"));
+    if (get_process_mitigation_policy &&
+        !get_process_mitigation_policy(::GetCurrentProcess(),
+                                       ProcessMitigationOptionsMask,
+                                       &mitigations, mits_size)) {
       NOTREACHED();
     }
   }
@@ -85,7 +92,14 @@ bool IsRunning32bitEmulatedOnArm64() {
 bool SetProcessMitigationPolicyInternal(PROCESS_MITIGATION_POLICY policy,
                                         PVOID lpBuffer,
                                         SIZE_T dwLength) {
-  PCHECK(::SetProcessMitigationPolicy(policy, lpBuffer, dwLength))
+  // SetProcessMitigationPolicy() requires Windows 8. Callers return before
+  // getting here on earlier versions.
+  static const auto set_process_mitigation_policy =
+      reinterpret_cast<decltype(&::SetProcessMitigationPolicy)>(
+          ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"),
+                           "SetProcessMitigationPolicy"));
+  PCHECK(set_process_mitigation_policy &&
+         set_process_mitigation_policy(policy, lpBuffer, dwLength))
       << "SetProcessMitigationPolicy failed with Policy: " << policy;
 
   return true;
@@ -158,6 +172,11 @@ bool ApplyProcessMitigationsToCurrentProcess(MitigationFlags starting_flags,
   }
 #endif
 
+  // This is all we can do in Win7 and below.
+  if (version < base::win::Version::WIN8) {
+    return true;
+  }
+
   // Enable ASLR policies.
   if (flags & MITIGATION_RELOCATE_IMAGE) {
     PROCESS_MITIGATION_ASLR_POLICY policy = {};
@@ -359,7 +378,13 @@ bool ApplyMitigationsToCurrentThread(MitigationFlags flags) {
     DWORD thread_policy = THREAD_DYNAMIC_CODE_ALLOW;
 
     // NOTE: Must use the pseudo-handle here, a thread HANDLE won't work.
-    if (!::SetThreadInformation(::GetCurrentThread(), ThreadDynamicCodePolicy,
+    // SetThreadInformation() is resolved at runtime because it requires
+    // Windows 8, although this is only reached on Windows 10 RS1+.
+    static const auto set_thread_information =
+        reinterpret_cast<decltype(&::SetThreadInformation)>(::GetProcAddress(
+            ::GetModuleHandleW(L"kernel32.dll"), "SetThreadInformation"));
+    if (!set_thread_information ||
+        !set_thread_information(::GetCurrentThread(), ThreadDynamicCodePolicy,
                                 &thread_policy, sizeof(thread_policy))) {
       return false;
     }
@@ -381,8 +406,15 @@ void ConvertProcessMitigationsToPolicy(MitigationFlags flags,
   *policy_value_1 = 0;
   *policy_value_2 = 0;
 
-#if defined(_WIN64) || defined(_M_IX86)
+#if defined(_WIN64)
   *size = sizeof(*policy_flags);
+#elif defined(_M_IX86)
+  // A 64-bit flags attribute is illegal on 32-bit Win 7.
+  if (version < base::win::Version::WIN8) {
+    *size = sizeof(DWORD);
+  } else {
+    *size = sizeof(*policy_flags);
+  }
 #else
 #error This platform is not supported.
 #endif
@@ -400,6 +432,11 @@ void ConvertProcessMitigationsToPolicy(MitigationFlags flags,
     *policy_value_1 |= PROCESS_CREATION_MITIGATION_POLICY_SEHOP_ENABLE;
 #endif
 
+  // Win 7 only supports DEP and SEHOP, and can't report what it supports.
+  if (version < base::win::Version::WIN8) {
+    return;
+  }
+
   if (flags & MITIGATION_RELOCATE_IMAGE) {
     *policy_value_1 |=
         PROCESS_CREATION_MITIGATION_POLICY_FORCE_RELOCATE_IMAGES_ALWAYS_ON;
@@ -572,6 +609,11 @@ void ConvertProcessMitigationsToComponentFilter(MitigationFlags flags,
 }
 
 MitigationFlags FilterPostStartupProcessMitigations(MitigationFlags flags) {
+  // Windows 7 can't set the heap mitigation at process creation.
+  if (base::win::GetVersion() < base::win::Version::WIN8) {
+    return flags & (MITIGATION_BOTTOM_UP_ASLR | MITIGATION_DLL_SEARCH_ORDER |
+                    MITIGATION_HEAP_TERMINATE);
+  }
   return flags & (MITIGATION_BOTTOM_UP_ASLR | MITIGATION_DLL_SEARCH_ORDER);
 }
 
