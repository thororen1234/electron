--- a/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_base/rand_util_win.cc
+++ b/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_base/rand_util_win.cc
@@ -21,6 +21,26 @@ BOOL WINAPI ProcessPrng(PBYTE pbData, SIZE_T cbData);
 
 namespace partition_alloc::internal::base {
 
+namespace {
+
+// ProcessPrng() requires Windows 10. Fall back to RtlGenRandom, exported by
+// advapi32 as SystemFunction036, which has a narrower signature.
+BOOL WINAPI RtlGenRandomFallback(PBYTE pbData, SIZE_T cbData) {
+  using RtlGenRandomFunc = BOOLEAN(WINAPI*)(PVOID, ULONG);
+  static const auto rtl_gen_random = reinterpret_cast<RtlGenRandomFunc>(
+      ::GetProcAddress(::LoadLibraryW(L"advapi32.dll"), "SystemFunction036"));
+  if (!rtl_gen_random) {
+    return FALSE;
+  }
+  // Requests never come close to 4GiB; reject them rather than split them.
+  if (cbData > 0xFFFFFFFFu) {
+    return FALSE;
+  }
+  return rtl_gen_random(pbData, static_cast<ULONG>(cbData)) ? TRUE : FALSE;
+}
+
+}  // namespace
+
 void RandBytes(void* output, size_t output_length) {
   // Import bcryptprimitives directly rather than cryptbase to avoid opening a
   // handle to \\Device\KsecDD in the renderer.
@@ -33,7 +53,9 @@ void RandBytes(void* output, size_t output_length) {
     PA_BASE_CHECK(hmod);
     process_prng_fn = reinterpret_cast<decltype(&ProcessPrng)>(
         GetProcAddress(hmod, "ProcessPrng"));
-    PA_BASE_CHECK(process_prng_fn);
+    if (!process_prng_fn) {
+      process_prng_fn = &RtlGenRandomFallback;
+    }
   }
   BOOL success = process_prng_fn(static_cast<BYTE*>(output), output_length);
   // ProcessPrng is documented to always return TRUE.
