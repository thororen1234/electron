@@ -87,6 +87,12 @@ void StartupInformationHelper::SetAppContainer(AppContainer* container) {
 }
 
 void StartupInformationHelper::AddJobToAssociate(HANDLE job_handle) {
+  // PROC_THREAD_ATTRIBUTE_JOB_LIST requires Windows 10. Before that, the
+  // suspended process is assigned to the job after it's created.
+  if (base::win::GetVersion() < base::win::Version::WIN10) {
+    job_to_assign_after_creation_ = job_handle;
+    return;
+  }
   job_handle_list_.push_back(job_handle);
 }
 
