+  // Win8+ adds a device DeviceApi that we don't need.
+  if (base::win::GetVersion() >= base::win::Version::WIN8) {
+    config->AddKernelObjectToClose(HandleToClose::kDeviceApi);
+  }
   config->SetDesktop(Desktop::kAlternateWinstation);
 
   return SBOX_ALL_OK;
@@ -639,7 +642,13 @@ ResultCode LaunchWithoutSandbox(
   // does not outlive the browser, which could happen if there is a lot of I/O
   // on process shutdown, in which case TerminateProcess can fail. See
   // https://crbug.com/820996.
-  if (delegate->ShouldUnsandboxedRunInJob()) {
+  // Prior to Windows 8 nested jobs aren't possible, so skip the job if this
+  // process is already in one.
+  BOOL in_job = FALSE;
+  const bool can_use_job =
+      base::win::GetVersion() >= base::win::Version::WIN8 ||
+      (::IsProcessInJob(::GetCurrentProcess(), nullptr, &in_job) && !in_job);
+  if (delegate->ShouldUnsandboxedRunInJob() && can_use_job) {
     static base::NoDestructor<base::win::ScopedHandle> job_object(
         CreateUnsandboxedJob());
     if (!job_object->is_valid()) {
@@ -671,6 +680,13 @@ bool IsUnsandboxedProcess(
     const base::CommandLine& launcher_process_command_line) {
   if (IsUnsandboxedSandboxType(sandbox_type))
     return true;
+  // On Windows 7 only renderers and the GPU process are sandboxed, as in
+  // Chromium before M110. Utility process sandboxes rely on features that
+  // don't exist before Windows 10, such as AppContainers.
+  if (base::win::GetVersion() < base::win::Version::WIN8 &&
+      sandbox_type != Sandbox::kRenderer && sandbox_type != Sandbox::kGpu) {
+    return true;
+  }
   if (cmd_line.HasSwitch(switches::kNoSandbox))
     return true;
   if (launcher_process_command_line.HasSwitch(switches::kNoSandbox))
@@ -738,6 +754,10 @@ void SandboxWin::AddBaseHandleClosePolicy(TargetConfig* config) {
 ResultCode SandboxWin::AddAppContainerPolicy(TargetConfig* config,
                                              base::wcstring_view sid) {
   DCHECK(!config->IsConfigured());
+  // AppContainers require Windows 8.
+  if (base::win::GetVersion() < base::win::Version::WIN8) {
+    return SBOX_ALL_OK;
+  }
   if (IsAppContainerEnabled()) {
     ResultCode result = config->SetLowBox(sid);
     if (result != SBOX_ALL_OK) {
@@ -972,9 +992,17 @@ ResultCode SandboxWin::StartSandboxedProcess(
   // Avoid making a policy if we won't use it.
   if (IsUnsandboxedProcess(delegate->GetSandboxType(), cmd_line,
                            *base::CommandLine::ForCurrentProcess())) {
+    // Most child processes run unsandboxed on Windows 7 (see
+    // IsUnsandboxedProcess()). Tell them so, or processes that expect a
+    // sandbox fail to enable it and exit.
+    base::CommandLine child_cmd_line = cmd_line;
+    if (base::win::GetVersion() < base::win::Version::WIN8 &&
+        !child_cmd_line.HasSwitch(switches::kNoSandbox)) {
+      child_cmd_line.AppendSwitch(switches::kNoSandbox);
+    }
     base::Process process;
     ResultCode result =
-        LaunchWithoutSandbox(cmd_line, *options, delegate, &process);
+        LaunchWithoutSandbox(child_cmd_line, *options, delegate, &process);
     DWORD last_error = GetLastError();
     std::move(result_callback).Run(std::move(process), last_error, result);
     return SBOX_ALL_OK;
diff --git a/sandbox/win/src/broker_services.cc b/sandbox/win/src/broker_services.cc
index 1787c7f7749b106e114add997caecc46d3bacd90..b558b3d96b59c8934c419a4ac294292eb1ff4c4e 100644
--- a/sandbox/win/src/broker_services.cc
+++ b/sandbox/win/src/broker_services.cc
@@ -278,6 +278,27 @@ ResultCode CreateSandboxProcess(
   if (startup_info->has_extended_startup_info()) {
     flags |= EXTENDED_STARTUPINFO_PRESENT;
   }
+
+  // Before Windows 10 the job is assigned after creation. Windows 7 doesn't
+  // support nested jobs, so break away from any job this process is in, or
+  // leave the target in that job if breaking away isn't allowed.
+  HANDLE job = startup_info_helper->job_to_assign_after_creation();
+  if (job && base::win::GetVersion() < base::win::Version::WIN8) {
+    BOOL in_job = FALSE;
+    if (::IsProcessInJob(::GetCurrentProcess(), nullptr, &in_job) && in_job) {
+      JOBOBJECT_EXTENDED_LIMIT_INFORMATION job_info = {};
+      if (::QueryInformationJobObject(nullptr,
+                                      JobObjectExtendedLimitInformation,
+                                      &job_info, sizeof(job_info), nullptr) &&
+          (job_info.BasicLimitInformation.LimitFlags &
+           JOB_OBJECT_LIMIT_BREAKAWAY_OK)) {
+        flags |= CREATE_BREAKAWAY_FROM_JOB;
+      } else {
+        job = nullptr;
+      }
+    }
+  }
+
   bool inherit_handles = startup_info_helper->ShouldInheritHandles();
   PROCESS_INFORMATION temp_process_info = {};
   std::wstring args = command_line.GetCommandLineString();
@@ -294,6 +315,13 @@ ResultCode CreateSandboxProcess(
   }
 
   process_info.Set(temp_process_info);
+
+  if (job && !::AssignProcessToJobObject(job, process_info.process_handle())) {
+    win_error = ::GetLastError();
+    ::TerminateProcess(process_info.process_handle(), 0);
+    return SBOX_ERROR_ASSIGN_PROCESS_TO_JOB_OBJECT;
+  }
+
   // Change the token of the main thread of the new process for the
   // impersonation token with more rights. This allows the target to start;
   // otherwise it will crash too early for us to help.
