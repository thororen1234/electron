@@ -175,6 +176,30 @@ bool HandleCloserAgent::CloseHandles() {
       handles.data(), static_cast<ULONG>(handles.size() * sizeof(uint32_t)),
       &return_length);
 
+  if (!NT_SUCCESS(status) &&
+      base::win::GetVersion() < base::win::Version::WIN8_1) {
+    // ProcessHandleTable requires Windows 8.1. Before that, probe handle
+    // values until every handle of the process has been found. Handles are
+    // multiples of 4, and a long run of invalid values means we've passed the
+    // end of the table.
+    constexpr int kInvalidHandleThreshold = 100;
+    uint32_t handle_value = 0;
+    int invalid_count = 0;
+    while (handle_count > 0 && invalid_count < kInvalidHandleThreshold) {
+      handle_value += 4;
+      HANDLE handle = base::win::Uint32ToHandle(handle_value);
+      auto type_name = GetTypeNameFromHandle(handle);
+      if (!type_name) {
+        ++invalid_count;
+        continue;
+      }
+      invalid_count = 0;
+      --handle_count;
+      MaybeCloseHandle(type_name.value(), handle);
+    }
+    return true;
+  }
+
   if (!NT_SUCCESS(status)) {
     ::SetLastError(GetLastErrorFromNtStatus(status));
     return false;
